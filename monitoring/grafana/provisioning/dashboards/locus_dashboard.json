{
  "title": "Locus — AI Fashion Search",
  "uid": "locus-main",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "timezone": "browser",
  "tags": ["locus", "ai", "fashion"],
  "time": { "from": "now-3h", "to": "now" },
  "panels": [

    {
      "id": 1, "type": "row", "title": "Qdrant Collections",
      "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2, "type": "stat",
      "title": "locus_items",
      "description": "Fashion products indexed and searchable",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{ "expr": "locus_qdrant_items_total{collection=\"locus_items\"}", "legendFormat": "Items" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 200 }
          ]},
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 3, "type": "stat",
      "title": "locus_skipped",
      "description": "Products rejected during ingestion (no clothing detected, low confidence)",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{ "expr": "locus_qdrant_items_total{collection=\"locus_skipped\"}", "legendFormat": "Skipped" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "orange" }
        }
      }
    },
    {
      "id": 4, "type": "stat",
      "title": "locus_feedback",
      "description": "User star ratings collected — need 200+ for CLIP fine-tuning",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{ "expr": "locus_qdrant_items_total{collection=\"locus_feedback\"}", "legendFormat": "Feedback" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "green", "value": 200 }
          ]},
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 5, "type": "timeseries",
      "title": "Collection sizes over time",
      "description": "Track catalog growth and feedback accumulation",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        { "expr": "locus_qdrant_items_total{collection=\"locus_items\"}",    "legendFormat": "locus_items" },
        { "expr": "locus_qdrant_items_total{collection=\"locus_skipped\"}",  "legendFormat": "locus_skipped" },
        { "expr": "locus_qdrant_items_total{collection=\"locus_feedback\"}", "legendFormat": "locus_feedback" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },

    {
      "id": 10, "type": "row", "title": "Gemini Visual Similarity Judge",
      "collapsed": false, "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 }
    },
    {
      "id": 11, "type": "gauge",
      "title": "Avg VSS@5 — Latest Eval Run",
      "description": "Average Gemini Visual Similarity Score. Baseline: 0.635. Target: >0.70",
      "gridPos": { "x": 0, "y": 14, "w": 5, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{ "expr": "locus_gemini_avg_vss5", "legendFormat": "VSS@5" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 }, { "color": "orange", "value": 0.55 },
            { "color": "yellow", "value": 0.70 }, { "color": "green", "value": 0.85 }
          ]},
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 12, "type": "stat",
      "title": "Queries Evaluated",
      "gridPos": { "x": 5, "y": 14, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{ "expr": "locus_gemini_queries_evaluated", "legendFormat": "Queries" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 13, "type": "stat",
      "title": "Cache Entries",
      "description": "Scored pairs saved to disk — these cost $0 on next eval run",
      "gridPos": { "x": 5, "y": 18, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{ "expr": "locus_gemini_cache_entries", "legendFormat": "Cached pairs" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }
      }
    },
    {
      "id": 14, "type": "bargauge",
      "title": "Grade Distribution",
      "description": "Queries by quality tier. Goal: eliminate red, grow green.",
      "gridPos": { "x": 9, "y": 14, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        { "expr": "locus_gemini_queries_excellent", "legendFormat": "Excellent  ≥0.85" },
        { "expr": "locus_gemini_queries_good",      "legendFormat": "Good       ≥0.70" },
        { "expr": "locus_gemini_queries_fair",      "legendFormat": "Fair       ≥0.55" },
        { "expr": "locus_gemini_queries_poor",      "legendFormat": "Poor        <0.55" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": 0 }] },
          "color": { "mode": "thresholds" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Excellent  ≥0.85" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Good       ≥0.70" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "light-green" } }] },
          { "matcher": { "id": "byName", "options": "Fair       ≥0.55" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "Poor        <0.55" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "id": 15, "type": "bargauge",
      "title": "VSS@5 Per Query",
      "description": "Score for each golden query. Red = poor (accessories/outerwear), green = good (basic clothing).",
      "gridPos": { "x": 15, "y": 14, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{ "expr": "sort_desc(locus_gemini_query_vss5)", "legendFormat": "{{label}}" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 }, { "color": "orange", "value": 0.55 },
            { "color": "yellow", "value": 0.70 }, { "color": "green", "value": 0.85 }
          ]},
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 16, "type": "timeseries",
      "title": "VSS@5 Trend — Across Eval Runs",
      "description": "This should go up after each CLIP fine-tuning round. Baseline is 0.635.",
      "gridPos": { "x": 0, "y": 22, "w": 14, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        { "expr": "locus_gemini_avg_vss5",  "legendFormat": "Avg VSS@5" },
        { "expr": "locus_gemini_avg_top1",  "legendFormat": "Avg Top-1" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 17, "type": "timeseries",
      "title": "Score Distribution Over Time",
      "description": "Cumulative count of individual result scores by bucket. Growing ≤1.0 line means more scored pairs in cache.",
      "gridPos": { "x": 14, "y": 22, "w": 10, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        { "expr": "locus_gemini_score_bucket{le=\"0.2\"}", "legendFormat": "≤0.20" },
        { "expr": "locus_gemini_score_bucket{le=\"0.4\"}", "legendFormat": "≤0.40" },
        { "expr": "locus_gemini_score_bucket{le=\"0.6\"}", "legendFormat": "≤0.60" },
        { "expr": "locus_gemini_score_bucket{le=\"0.8\"}", "legendFormat": "≤0.80" },
        { "expr": "locus_gemini_score_bucket{le=\"1.0\"}", "legendFormat": "≤1.00" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 20, "type": "row", "title": "Service Health",
      "collapsed": false, "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 }
    },
    {
      "id": 21, "type": "timeseries",
      "title": "Request Rate by Endpoint (req/s)",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        { "expr": "rate(http_requests_total{handler=\"/search\"}[1m])",   "legendFormat": "/search" },
        { "expr": "rate(http_requests_total{handler=\"/detect\"}[1m])",   "legendFormat": "/detect" },
        { "expr": "rate(http_requests_total{handler=\"/feedback\"}[1m])", "legendFormat": "/feedback" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 22, "type": "timeseries",
      "title": "P95 Response Latency by Endpoint (s)",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{handler=\"/search\"}[2m]))",   "legendFormat": "/search p95" },
        { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{handler=\"/detect\"}[2m]))",   "legendFormat": "/detect p95" },
        { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{handler=\"/feedback\"}[2m]))", "legendFormat": "/feedback p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 23, "type": "timeseries",
      "title": "Error Rate (4xx + 5xx per second)",
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{ "expr": "rate(http_requests_total{status=~\"4..|5..\"}[1m])", "legendFormat": "Errors/s" }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 24, "type": "timeseries",
      "title": "Searches by Detected Category",
      "description": "What types of clothing users are searching for most",
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{ "expr": "rate(locus_searches_total[5m])", "legendFormat": "{{category}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 25, "type": "bargauge",
      "title": "Feedback — Star Rating Distribution",
      "description": "All-time feedback by star rating. 4-5 = positive training signal, 1-2 = negative.",
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        { "expr": "sum(locus_feedback_stars_total{stars=\"5\"})", "legendFormat": "5 stars" },
        { "expr": "sum(locus_feedback_stars_total{stars=\"4\"})", "legendFormat": "4 stars" },
        { "expr": "sum(locus_feedback_stars_total{stars=\"3\"})", "legendFormat": "3 stars" },
        { "expr": "sum(locus_feedback_stars_total{stars=\"2\"})", "legendFormat": "2 stars" },
        { "expr": "sum(locus_feedback_stars_total{stars=\"1\"})", "legendFormat": "1 star" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 26, "type": "stat",
      "title": "Positive Feedback Ratio",
      "description": "Ratio of 4-5 star ratings vs all non-neutral ratings. >70% = users happy with results.",
      "gridPos": { "x": 12, "y": 44, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [{
        "expr": "sum(locus_feedback_stars_total{signal=\"positive\"}) / (sum(locus_feedback_stars_total{signal=\"positive\"}) + sum(locus_feedback_stars_total{signal=\"negative\"}))",
        "legendFormat": "Positive ratio"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.7 }
          ]},
          "color": { "mode": "thresholds" }
        }
      }
    }
  ],

  "annotations": {
    "list": [{
      "builtIn": 1,
      "datasource": { "type": "grafana", "uid": "-- Grafana --" },
      "enable": true,
      "hide": true,
      "iconColor": "rgba(0, 211, 255, 1)",
      "name": "Annotations & Alerts",
      "type": "dashboard"
    }]
  }
}
